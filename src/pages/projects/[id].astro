---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import Link from '../../components/Link.astro';
import Screenshots from '../../components/Screenshots.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nextProject, visibleProjects } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const all = await getCollection('projects');
  const shown = visibleProjects(all);
  return shown.map((project) => ({
    params: { id: project.id },
    props: {
      project,
      next: nextProject(all, project.id),
      figureNumber: String(
        shown.findIndex((p) => p.id === project.id) + 1,
      ).padStart(2, '0'),
    },
  }));
}) satisfies GetStaticPaths;

const { project, next, figureNumber } = Astro.props;
const { title, summary, type, screenshots, links, stack, decisions } =
  project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Type', value: type },
  { label: 'Stack', value: stack.join(', ') },
];
// Type, Stack, Source, and Live when the project has a live preview.
const factCount = facts.length + (links.live ? 2 : 1);
---

<BaseLayout title={title} description={`${title}: ${summary}`}>
  <div class="relative pt-[clamp(1.5rem,1rem+2vw,3rem)] pb-[clamp(2rem,1rem+4vw,5rem)]">
    <div class="relative mx-auto w-[min(var(--container-page),100%-2*var(--spacing-edge))]">
      <Link
        href="/#projects"
        arrow="←"
        data-back
        class="mono inline-flex min-h-11 items-center text-muted"
      >
        All projects
      </Link>
      <h1 class="mt-[clamp(1.5rem,1rem+3vw,4rem)] -ml-[.04em] text-[clamp(2.5rem,1rem+8vw,8rem)] leading-[.86] font-[560] tracking-[-0.065em]">
        {title}
      </h1>
    </div>
  </div>
  <div class="mx-auto w-[min(var(--container-page),100%-2*var(--spacing-edge))]">
    <dl class="facts border-t border-rule" data-count={factCount}>
      {facts.map(({ label, value }) => (
        <div>
          <dt class="mono text-muted">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
      {links.live && (
        <div>
          <dt class="mono text-muted">Live</dt>
          <dd>
            <Link href={links.live} arrow="↗">
              Preview
            </Link>
          </dd>
        </div>
      )}
      <div>
        <dt class="mono text-muted">Source</dt>
        <dd>
          <Link href={links.github} arrow="↗">
            GitHub
          </Link>
        </dd>
      </div>
    </dl>
  </div>

  <!-- The facts end the header block, so the first section needs no divider above it. -->
  <div class="[&>section:first-child]:border-t-0">
    <Section
      id="what-it-is"
      index="01"
      label="What it is"
      title={summary}
      oneLine={false}
    >
      <div class="prose mt-8 grid max-w-[52ch] gap-5 text-step-1 leading-[1.4] tracking-[-0.015em] text-muted">
        <Content />
      </div>
    </Section>
    <Section
      id="screenshots"
      index="02"
      label="Screenshots"
      title="What it looks like,"
      accent="up close."
    >
      <div class="mt-[clamp(2rem,1rem+3vw,4rem)]">
        <Screenshots screenshots={screenshots} number={figureNumber} />
      </div>
    </Section>
    {decisions && (
      <Section
        id="decisions"
        index="03"
        label="Decisions"
        title="How it is built,"
        accent="and why."
      >
        <ol class="mt-[clamp(2rem,1rem+3vw,4rem)] list-none border-t border-rule p-0">
          {decisions.map((decision, i) => (
            <li class="decision">
              <span class="mono text-accent">3.{i + 1}</span>
              <h3 class="text-step-1 font-[520] tracking-[-0.03em]">
                {decision.title}
              </h3>
              <p class="text-muted">{decision.text}</p>
            </li>
          ))}
        </ol>
      </Section>
    )}
  </div>

  {next && (
    <div class="mx-auto w-[min(var(--container-page),100%-2*var(--spacing-edge))]">
      <a
        href={`/projects/${next.id}/`}
        class="next block border-t border-rule py-[clamp(2rem,1rem+4vw,4.5rem)]"
      >
        <span class="mono text-muted">Next project</span>
        <strong class="mt-4 block text-[clamp(1.75rem,.75rem+4vw,4.5rem)] leading-[.95] font-[560] tracking-[-0.05em]">
          {next.data.title} <Arrow direction="right" class="text-accent" />
        </strong>
      </a>
    </div>
  )}
</BaseLayout>

<style>
  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }

  .facts > div:first-child {
    border-top: 0;
  }

  /* Tablets and desktop: the facts sit side by side. */
  @media (min-width: 40rem) {
    .facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts > div {
      display: grid;
      grid-template-columns: none;
      align-content: start;
      gap: 0.5rem;
      padding: 1.1rem var(--spacing-gutter) 1.1rem 0;
    }

    .facts > div:nth-child(2) {
      border-top: 0;
    }

    .facts > div:nth-child(even) {
      padding-left: var(--spacing-gutter);
      border-left: 1px solid var(--rule);
    }

    /* An odd last fact takes the whole row, so there is no empty cell. */
    .facts > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: one column per fact, so a project with fewer facts still fills the row. */
  .facts[data-count='3'] {
    --count: 3;
  }

  @media (min-width: 64rem) {
    .facts {
      grid-template-columns: repeat(var(--count, 4), minmax(0, 1fr));
    }

    .facts > div {
      border-top: 0;
    }

    .facts > div:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .facts > div + div {
      padding-left: var(--spacing-gutter);
      border-left: 1px solid var(--rule);
    }
  }

  .decision {
    display: grid;
    gap: 1rem var(--spacing-gutter);
    align-items: baseline;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .decision:last-child {
    border-bottom: 0;
  }

  @media (min-width: 64rem) {
    .decision {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.6fr);
    }
  }

  @media (hover: hover) {
    .next strong {
      transition: transform 0.5s var(--ease-out-expo);
    }

    .next:hover strong {
      transform: translateX(1rem);
    }
  }
</style>

<script>
  // Coming from the home page, "All projects" goes back to where the visitor was,
  // at the same scroll position. Opened directly, it is a normal link to the projects.
  const link = document.querySelector<HTMLAnchorElement>('[data-back]');
  const cameFromHome = (() => {
    try {
      const from = new URL(document.referrer);
      return from.origin === location.origin && from.pathname === '/';
    } catch {
      return false;
    }
  })();

  // A new tab opened from the home page has no history to go back to, and a click with
  // a modifier key (open in a new tab or window) must keep its normal meaning.
  if (link && cameFromHome && history.length > 1) {
    link.addEventListener('click', (event) => {
      const modified =
        event.button !== 0 ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey ||
        event.altKey;
      if (modified) return;
      event.preventDefault();
      history.back();
    });
  }
</script>
