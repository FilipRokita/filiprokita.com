---
import type { HTMLAttributes } from 'astro/types';
import Arrow from './Arrow.astro';

interface Props extends HTMLAttributes<'a'> {
  /** An arrow: ↗ after the text on outbound links, ← before it on a link back. */
  arrow?: '↗' | '←';
  /** A resting underline even with an arrow. For the main calls to action. */
  underlined?: boolean;
}

const {
  arrow,
  underlined = false,
  class: className,
  href,
  rel,
  ...rest
} = Astro.props;

// A link to another site opens in a new tab. Email and links within the site do not.
const external = typeof href === 'string' && /^https?:\/\//.test(href);
---

<a
  class:list={['link', { rest: !arrow || underlined }, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? [rel, 'noopener'].filter(Boolean).join(' ') : rel}
  {...rest}
>
  {arrow === '←' && <Arrow direction="left" class="back" />}
  <slot />
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  {arrow === '↗' && <Arrow direction="up-right" class="arr" />}
</a>

<style>
  .link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
  }

  /* The underline, and the violet line that fills in from the left on hover. */
  .link::before,
  .link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.1rem;
    height: 1px;
    transform-origin: left;
    transform: scaleX(0);
  }

  /* A link with an arrow is marked by it. One without gets a resting underline. */
  .link::after {
    background: currentcolor;
  }

  .link.rest::after {
    opacity: 0.15;
    transform: scaleX(1);
  }

  .link::before {
    z-index: 1;
    background: var(--accent);
    transition: transform 0.35s var(--ease-out-expo);
  }

  .link:focus-visible::before {
    transform: scaleX(1);
  }

  .link :global(.back) {
    margin-right: 0.4rem;
    color: var(--accent);
  }

  .link :global(.arr) {
    margin-left: 0.35rem;
    color: var(--accent);
    transition: transform 0.3s;
  }

  /* Hover effects only where there is a real hover, so nothing sticks after a tap. */
  @media (hover: hover) {
    .link:hover::before {
      transform: scaleX(1);
    }

    .link:hover :global(.arr) {
      transform: translate(0.2rem, -0.2rem);
    }
  }
</style>
