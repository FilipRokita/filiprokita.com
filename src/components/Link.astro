---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  /** An arrow after the text. */
  arrow?: '↗';
}

const { arrow, class: className, href, rel, ...rest } = Astro.props;

// A link to another site opens in a new tab. Email and links within the site do not.
const external = typeof href === 'string' && /^https?:\/\//.test(href);
---

<a
  class:list={['link', { rest: !arrow }, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? [rel, 'noopener'].filter(Boolean).join(' ') : rel}
  {...rest}
>
  <slot />
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  {arrow && (
    <span class="arr" aria-hidden="true">
      {arrow}
    </span>
  )}
</a>

<style>
  .link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
  }

  /* The underline, and the violet line that fills in from the left on hover. */
  .link::before,
  .link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.1rem;
    height: 1px;
    transform-origin: left;
    transform: scaleX(0);
  }

  /* A link with an arrow is marked by it. One without gets a resting underline. */
  .link::after {
    background: currentcolor;
  }

  .link.rest::after {
    opacity: 0.15;
    transform: scaleX(1);
  }

  .link::before {
    z-index: 1;
    background: var(--accent);
    transition: transform 0.35s var(--ease-out-expo);
  }

  .link:focus-visible::before {
    transform: scaleX(1);
  }

  .arr {
    display: inline-block;
    margin-left: 0.6rem;
    color: var(--accent);
    transition: transform 0.3s;
  }

  /* Hover effects only where there is a real hover, so nothing sticks after a tap. */
  @media (hover: hover) {
    .link:hover::before {
      transform: scaleX(1);
    }

    .link:hover .arr {
      transform: translate(0.2rem, -0.2rem);
    }
  }
</style>
