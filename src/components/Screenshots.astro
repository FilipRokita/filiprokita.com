---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Modal from './Modal.astro';

interface Props {
  screenshots: { src: ImageMetadata; alt: string; caption: string }[];
  /** The project's figure number, such as "02". The first screenshot is Fig. 02, then 02.2. */
  number: string;
}

const { screenshots, number } = Astro.props;
const label = (index: number) =>
  index === 0 ? number : `${number}.${index + 1}`;
---

<div class="shots" data-bp="Screenshots.astro">
  {screenshots.map(({ src, alt, caption }, index) => (
    <figure>
      <button
        type="button"
        class="mat"
        data-modal-open="screenshots-preview"
        data-modal-slide={index}
        aria-label={`Open screenshot: ${alt}`}
      >
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <Image
          src={src}
          alt={alt}
          sizes={
            index === 0
              ? '(min-width: 64rem) 66vw, 100vw'
              : '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw'
          }
          widths={[640, 960, 1280, 1600]}
          loading="lazy"
        />
      </button>
      <figcaption class="mono">
        <span>Fig. {label(index)}</span>
        <span>{caption}</span>
      </figcaption>
    </figure>
  ))}
</div>

<!-- One window for the whole set: the slides sit inside it, and the opener picks one. -->
<Modal id="screenshots-preview" label="Screenshots">
  {screenshots.map(({ src, alt, caption }, index) => (
    <div data-slide data-title={`Fig. ${label(index)}`} data-caption={caption}>
      <Image src={src} alt={alt} sizes="100vw" widths={[1600]} loading="lazy" />
    </div>
  ))}
</Modal>

<style>
  .shots {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem) 2rem;
  }

  @media (min-width: 40rem) {
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shots > :first-child {
      grid-column: 1 / -1;
    }
  }

  figure {
    margin: 0;
  }

  /* The screenshot sits on a mat, with drawing corners. */
  .mat {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(0.5rem, 0.3rem + 0.8vw, 1rem);
    background: var(--panel);
    border: 1px solid var(--rule);
    cursor: zoom-in;
  }

  .mat:disabled {
    cursor: default;
  }

  .mat img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .mat i {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 0 solid var(--muted);
  }

  .mat i:nth-of-type(1) {
    top: 3px;
    left: 3px;
    border-width: 1px 0 0 1px;
  }

  .mat i:nth-of-type(2) {
    top: 3px;
    right: 3px;
    border-width: 1px 1px 0 0;
  }

  .mat i:nth-of-type(3) {
    bottom: 3px;
    left: 3px;
    border-width: 0 0 1px 1px;
  }

  .mat i:nth-of-type(4) {
    right: 3px;
    bottom: 3px;
    border-width: 0 1px 1px 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--muted);
  }

  /* On paper: the screenshot alone, no mat and no corners. */
  @media print {
    .mat {
      padding: 0;
      border: 0;
    }

    .mat i {
      display: none;
    }
  }
</style>

<script>
  // The preview is for screens wide enough to gain from it. On a phone the screenshot is
  // already the full width of the page, and pinching it zooms in sharp, so it is not a button.
  const wide = matchMedia('(min-width: 40rem)');
  const sync = () => {
    document
      .querySelectorAll<HTMLButtonElement>('.mat')
      .forEach((button) => (button.disabled = !wide.matches));
  };
  sync();
  wide.addEventListener('change', sync);
</script>
