---
import { site } from '../config/site';
import Container from './Container.astro';
import Link from './Link.astro';
import ThemeToggle from './ThemeToggle.astro';

const { date, commit } = __BUILD__;
const commitUrl =
  site.repoIsPublic && commit ? `${site.repo}/commit/${commit}` : undefined;
---

<footer class="border-t border-rule pt-7 pb-10 text-muted">
  <Container class="mono flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-x-8">
    <p>
      © {site.name}{' '}
      <span class="block sm:inline">
        <span class="hidden sm:inline">· </span>Built {date}
        {commit && (
          <>
            {' · '}
            {commitUrl ? (
              <Link href={commitUrl} class="!py-[.15rem]">
                {commit}
              </Link>
            ) : (
              commit
            )}
          </>
        )}
      </span>
    </p>
    <div class="flex flex-wrap items-baseline gap-6">
      <Link href={`mailto:${site.email}`} class="!py-[.15rem]">
        Email
      </Link>
      <Link href={site.linkedin} rel="me" class="!py-[.15rem]">
        LinkedIn
      </Link>
      <Link href={site.github} rel="me" class="!py-[.15rem]">
        GitHub
      </Link>
      <!-- A quiet hint for people with a keyboard. Not a button. Shown by the script below. -->
      <kbd
        class="shortcut mono font-[inherit] text-muted"
        data-shortcut-hint
        hidden
        aria-hidden="true"
      >
        Ctrl K
      </kbd>
      <ThemeToggle />
    </div>
  </Container>
</footer>

<style>
  .shortcut {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    opacity: 0.8;
  }
</style>

<script>
  // Only where there is a keyboard and a mouse. The key is named for the platform.
  const hint = document.querySelector<HTMLElement>('[data-shortcut-hint]');
  if (hint && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const apple = /Mac|iPhone|iPad/.test(navigator.userAgent);
    hint.textContent = apple ? '⌘ K' : 'Ctrl K';
    hint.hidden = false;
  }
</script>
