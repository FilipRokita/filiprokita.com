---
// Rendered hidden: the script shows it, because without JavaScript it cannot work.
---

<button
  type="button"
  class="theme-toggle print:hidden mono inline-flex min-w-[4.5em] cursor-pointer items-center justify-end gap-[.5ch] text-muted sm:min-w-[8.5em]"
  data-theme-toggle
  hidden
>
  <span data-theme-name></span>
  <span class="hidden sm:inline">mode</span>
</button>

<style>
  .theme-toggle {
    transition: color 0.2s;
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      color: var(--fg);
    }
  }
</style>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const current = (): Theme => {
    const chosen = root.dataset.theme;
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  };

  // The label names the theme a click switches to.
  const render = () => {
    for (const toggle of toggles) {
      const name = toggle.querySelector('[data-theme-name]');
      if (name) name.textContent = current() === 'dark' ? 'Light' : 'Dark';
      toggle.hidden = false;
    }
  };

  const setTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    window.applyThemeColor?.(theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage can be blocked. The choice then lasts for this page only.
    }
    render();
  };

  // The circle grows from the point the switch was asked for: a toggle, or a palette entry.
  const switchTheme = (x: number, y: number) => {
    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    if (!document.startViewTransition || reducedMotion.matches)
      return setTheme(next);

    root.style.setProperty('--tx', `${x}px`);
    root.style.setProperty('--ty', `${y}px`);
    root.classList.add('theme-vt');
    document
      .startViewTransition(() => setTheme(next))
      .finished.finally(() => root.classList.remove('theme-vt'));
  };

  for (const toggle of toggles) {
    toggle.addEventListener('click', () => {
      const box = toggle.getBoundingClientRect();
      switchTheme(box.left + box.width / 2, box.top + box.height / 2);
    });
  }
  // The command palette asks for a switch with the point to grow the circle from.
  addEventListener('switch-theme', (event) => {
    const { x, y } = (event as CustomEvent<{ x: number; y: number }>).detail;
    switchTheme(x, y);
  });

  // With no saved choice the system theme applies, so the label follows it.
  matchMedia('(prefers-color-scheme: light)').addEventListener(
    'change',
    render,
  );
  render();
</script>
