---
// A square as tall as the blueprint chip beside it (both are `h-7`). Rendered hidden (but keeping its room, so nothing shifts) until the script shows it, because
// without JavaScript it cannot work.
---

<button
  type="button"
  class="theme-toggle print:hidden inline-flex size-7 flex-none cursor-pointer items-center justify-center border border-rule text-fg"
  data-theme-toggle
  data-bp="ThemeToggle.astro"
  data-pending
>
  <svg
    viewBox="0 0 16 16"
    width="15"
    height="15"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="8" cy="8" r="6.25"></circle>
    <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    transition: border-color 0.2s;
  }

  .theme-toggle[data-pending] {
    visibility: hidden;
  }

  /* A bigger area to tap than the button looks. */
  .theme-toggle::before {
    content: '';
    position: absolute;
    inset: -0.4rem;
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .theme-toggle path {
    fill: currentColor;
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      border-color: var(--accent);
    }
  }
</style>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const current = (): Theme => {
    const chosen = root.dataset.theme;
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  };

  // The accessible name says which theme a click switches to.
  const render = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    for (const toggle of toggles) {
      toggle.setAttribute('aria-label', `Switch to ${next} theme`);
      toggle.removeAttribute('data-pending');
    }
  };

  const setTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    window.applyThemeColor?.(theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage can be blocked. The choice then lasts for this page only.
    }
    render();
  };

  // The circle grows from the point the switch was asked for: a toggle, or a palette entry.
  const switchTheme = (x: number, y: number) => {
    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    if (!document.startViewTransition || reducedMotion.matches)
      return setTheme(next);

    root.style.setProperty('--tx', `${x}px`);
    root.style.setProperty('--ty', `${y}px`);
    root.classList.add('theme-vt');
    document
      .startViewTransition(() => setTheme(next))
      .finished.finally(() => root.classList.remove('theme-vt'));
  };

  for (const toggle of toggles) {
    toggle.addEventListener('click', () => {
      const box = toggle.getBoundingClientRect();
      switchTheme(box.left + box.width / 2, box.top + box.height / 2);
    });
  }
  // The command palette asks for a switch with the point to grow the circle from.
  addEventListener('switch-theme', (event) => {
    const { x, y } = (event as CustomEvent<{ x: number; y: number }>).detail;
    switchTheme(x, y);
  });

  // With no saved choice the system theme applies, so the label follows it.
  matchMedia('(prefers-color-scheme: light)').addEventListener(
    'change',
    render,
  );
  render();
</script>
