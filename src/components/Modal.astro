---
import Arrow from './Arrow.astro';

interface Props {
  /** The id that an opener points to with `data-modal-open="<id>"`. */
  id: string;
  /** The accessible name of the window. */
  label: string;
  /** Mono text on the left of the title bar, such as "Fig. 05.2". */
  title?: string;
  /** Mono text on the right of the title bar, before the buttons. */
  caption?: string;
}

const { id, label, title, caption } = Astro.props;
---

<!--
  Put anything inside. To make it a gallery, put several children marked data-slide, each
  with data-title and data-caption for the title bar. An opener can choose the slide with
  data-modal-slide="<index>". With more than one slide the window gets the previous and next
  buttons, a counter and the arrow keys.
-->
<dialog id={id} class="modal" aria-label={label} data-bp="Modal.astro">
  <div class="bar mono">
    <span class="status" aria-live="polite" aria-atomic="true">
      <span data-modal-title>{title}</span>
      <span class="caption" data-modal-caption>
        {caption}
      </span>
      <span class="count" data-modal-count data-modal-gallery hidden></span>
    </span>
    <div class="cells">
      <button
        type="button"
        class="cell"
        data-modal-prev
        data-modal-gallery
        aria-label="Previous"
        hidden
      >
        <Arrow direction="left" />
      </button>
      <button
        type="button"
        class="cell"
        data-modal-next
        data-modal-gallery
        aria-label="Next"
        hidden
      >
        <Arrow direction="right" />
      </button>
      <button
        type="button"
        class="cell"
        data-modal-close
        aria-label="Close"
        autofocus
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="body">
    <slot />
  </div>
</dialog>

<style>
  /* A small window: a title bar with an X, then whatever is put inside. */
  .modal {
    width: fit-content;
    max-width: min(100vw - 2rem, 80rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    color: var(--fg);
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .modal::backdrop {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-left: 1rem;
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }

  .status {
    display: flex;
    flex: 1;
    gap: 1rem;
    align-items: center;
    min-width: 0;
  }

  .caption {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .count {
    flex: none;
  }

  .cells {
    display: flex;
    flex: none;
  }

  .cell {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.1rem;
    color: var(--fg);
    background: none;
    border: 0;
    border-left: 1px solid var(--rule);
    cursor: pointer;
  }

  .cell:hover {
    background: var(--bg);
  }

  /* At the first or last slide a button is dimmed but stays focusable, so focus does not jump. */
  .cell[aria-disabled='true'] {
    color: var(--muted);
    cursor: default;
    opacity: 0.4;
  }

  .cell[aria-disabled='true']:hover {
    background: none;
  }

  .cell path {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
  }

  /* On paper there is no window. */
  @media print {
    .modal {
      display: none;
    }
  }

  /* An image inside fits the window, whatever its size. */
  .body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 2rem - 2.75rem - 1px);
    margin-inline: auto;
  }

  /* In a gallery the slides sit on top of each other and the current one shows. */
  .modal[data-gallery] .body {
    display: grid;
  }

  .body > :global([data-slide]) {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
  }

  .body > :global([data-slide][data-active]) {
    visibility: visible;
    opacity: 1;
  }

  /* It fades in and rises 0.75rem, like the sections do, and back out. Where the browser cannot animate a dialog, it just
     appears. Nothing moves for a visitor who asks for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    .modal,
    .modal::backdrop {
      opacity: 0;
      transition:
        opacity 0.3s ease,
        transform 0.5s var(--ease-out-expo),
        overlay 0.5s allow-discrete,
        display 0.5s allow-discrete;
    }

    .modal {
      transform: translateY(0.75rem);
    }

    .body > :global([data-slide]) {
      transition:
        opacity 0.3s ease,
        visibility 0.3s;
    }

    .modal[open],
    .modal[open]::backdrop {
      opacity: 1;
    }

    .modal[open] {
      transform: none;
    }

    @starting-style {
      .modal[open],
      .modal[open]::backdrop {
        opacity: 0;
      }

      .modal[open] {
        transform: translateY(0.75rem);
      }
    }
  }
</style>

<script>
  // Anything with data-modal-open="<id>" opens that window, on the slide data-modal-slide names.
  // The X, Esc and a click on the backdrop close it. Previous, next and the arrow keys move
  // between slides. In blueprint mode a click never gets here: that mode catches it first.
  const slidesOf = (dialog: HTMLDialogElement) => [
    ...dialog.querySelectorAll<HTMLElement>('.body > [data-slide]'),
  ];

  const setText = (root: ParentNode, selector: string, value: string) => {
    const element = root.querySelector(selector);
    if (element) element.textContent = value;
  };

  // With more than one slide, the window becomes a gallery: it shows the buttons and the
  // counter, and its parts get the roles of a carousel.
  const prepare = (dialog: HTMLDialogElement) => {
    const slides = slidesOf(dialog);
    if (slides.length < 2 || dialog.hasAttribute('data-gallery')) return;
    dialog.setAttribute('data-gallery', '');
    const body = dialog.querySelector('.body');
    body?.setAttribute('role', 'group');
    body?.setAttribute('aria-roledescription', 'carousel');
    body?.setAttribute('aria-label', dialog.getAttribute('aria-label') ?? '');
    slides.forEach((slide, n) => {
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'slide');
      slide.setAttribute('aria-label', `${n + 1} of ${slides.length}`);
    });
    for (const part of dialog.querySelectorAll('[data-modal-gallery]')) {
      part.removeAttribute('hidden');
    }
  };

  // Shows one slide: the title bar follows it, and the buttons dim at either end.
  const show = (dialog: HTMLDialogElement, index: number) => {
    const slides = slidesOf(dialog);
    if (!slides.length) return;
    const last = slides.length - 1;
    const at = Number.isFinite(index) ? Math.max(0, Math.min(index, last)) : 0;
    slides.forEach((slide, n) =>
      slide.toggleAttribute('data-active', n === at),
    );
    dialog.dataset.index = String(at);
    setText(dialog, '[data-modal-title]', slides[at].dataset.title ?? '');
    setText(dialog, '[data-modal-caption]', slides[at].dataset.caption ?? '');
    setText(dialog, '[data-modal-count]', `${at + 1} / ${slides.length}`);
    dialog
      .querySelector('[data-modal-prev]')
      ?.setAttribute('aria-disabled', String(at === 0));
    dialog
      .querySelector('[data-modal-next]')
      ?.setAttribute('aria-disabled', String(at === last));
  };

  const step = (dialog: HTMLDialogElement, by: number) =>
    show(dialog, Number(dialog.dataset.index ?? 0) + by);

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const opener = event.target.closest<HTMLElement>('[data-modal-open]');
    if (opener) {
      const dialog = document.getElementById(opener.dataset.modalOpen ?? '');
      if (dialog instanceof HTMLDialogElement) {
        prepare(dialog);
        show(dialog, Number(opener.dataset.modalSlide ?? 0));
        dialog.showModal();
      }
      return;
    }
    const move = event.target.closest<HTMLElement>(
      '[data-modal-prev], [data-modal-next]',
    );
    if (move) {
      const dialog = move.closest('dialog');
      if (dialog && move.getAttribute('aria-disabled') !== 'true') {
        step(dialog, move.hasAttribute('data-modal-next') ? 1 : -1);
      }
    } else if (event.target.closest('[data-modal-close]')) {
      event.target.closest('dialog')?.close();
    } else if (
      event.target instanceof HTMLDialogElement &&
      event.target.classList.contains('modal')
    ) {
      event.target.close();
    }
  });

  addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey)
      return;
    const dialog = document.querySelector<HTMLDialogElement>(
      'dialog.modal[open][data-gallery]',
    );
    // Only while the gallery itself has the focus: the command palette can sit on top of it.
    if (!dialog || !(event.target instanceof Node)) return;
    if (!dialog.contains(event.target)) return;
    event.preventDefault();
    step(dialog, event.key === 'ArrowRight' ? 1 : -1);
  });
</script>
