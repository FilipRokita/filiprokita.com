---
import { site } from '../config/site';
import Guides from './Guides.astro';
import Link from './Link.astro';
---

<section
  data-bp="Hero.astro"
  class="hero relative pt-[clamp(2.5rem,1rem+3vw,4rem)] pb-section"
>
  <Guides />
  <!-- On a mouse, the column lines light up near the pointer. -->
  <div
    class="lit absolute inset-0 pointer-events-none print:hidden"
    aria-hidden="true"
  >
    <Guides lit />
  </div>
  <div class="relative mx-auto w-[min(var(--container-page),100%-2*var(--spacing-edge))]">
    <div
      data-intro="fade"
      class="mono flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pb-[clamp(2rem,1rem+6vw,7rem)] text-muted"
    >
      <span>
        Kraków, PL
        <span data-clock-wrap hidden>
          {' '}
          · <time data-clock></time> local
        </span>{' '}
        · remote
      </span>
      <span class="max-md:hidden" data-hello>
        Hello, world
      </span>
    </div>
    <h1 class="title font-[560] tracking-[-0.065em] whitespace-nowrap">
      <span class="sr-only">{site.name}</span>
      <span class="line" aria-hidden="true">
        {[...site.name].map((letter) => (
          <span class="letter" data-intro="rise">
            {letter === ' ' ? '\u00a0' : letter}
          </span>
        ))}
      </span>
    </h1>
    <div
      data-intro="fade"
      class="mt-[clamp(2.5rem,1rem+5vw,6rem)] grid grid-cols-12 items-start gap-x-gutter gap-y-8"
    >
      <p class="mono col-span-12 text-muted max-md:hidden md:col-span-3">
        ( Overview )
      </p>
      <p class="col-span-12 text-step-2 font-[450] tracking-[-0.035em] md:col-span-6 md:col-start-4">
        <span class="block">Software engineer</span>
        <em class="block text-muted not-italic">building apps, data and AI,</em>
        <em class="block text-muted not-italic">from idea to production.</em>
      </p>
      <p class="mono col-span-12 flex flex-wrap items-baseline gap-x-7 gap-y-1 md:col-span-9 md:col-start-4 lg:col-span-3 lg:col-start-10">
        <Link href={`mailto:${site.email}`} underlined class="text-[.85rem]">
          Email
        </Link>
        <Link
          href={site.linkedin}
          rel="me"
          arrow="↗"
          underlined
          class="text-[.85rem]"
        >
          LinkedIn
        </Link>
        <Link
          href={site.github}
          rel="me"
          arrow="↗"
          underlined
          class="text-[.85rem]"
        >
          GitHub
        </Link>
      </p>
    </div>
  </div>
</section>

<style>
  /* The name fills the width of the page. */
  .title {
    position: relative;
    margin-left: -0.04em;
    font-size: min(
      calc((100vw - 2 * var(--spacing-edge)) / 4.75),
      calc(var(--container-page) / 4.75)
    );
    line-height: 0.86;
  }

  /* The line clips its text, so a later reveal can slide the text up from below. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .letter {
    display: inline-block;
  }

  /* The letters rise one after the other. */
  @media (prefers-reduced-motion: no-preference) {
    .letter:nth-child(2) {
      animation-delay: 0.03s;
    }
    .letter:nth-child(3) {
      animation-delay: 0.06s;
    }
    .letter:nth-child(4) {
      animation-delay: 0.09s;
    }
    .letter:nth-child(5) {
      animation-delay: 0.12s;
    }
    .letter:nth-child(6) {
      animation-delay: 0.15s;
    }
    .letter:nth-child(7) {
      animation-delay: 0.18s;
    }
    .letter:nth-child(8) {
      animation-delay: 0.21s;
    }
    .letter:nth-child(9) {
      animation-delay: 0.24s;
    }
    .letter:nth-child(10) {
      animation-delay: 0.27s;
    }
    .letter:nth-child(11) {
      animation-delay: 0.3s;
    }
    .letter:nth-child(12) {
      animation-delay: 0.33s;
    }
  }

  /* The lit column lines. Off until a mouse moves over the hero. */
  .lit {
    opacity: 0;
    transition: opacity 0.4s;
    mask-image: radial-gradient(
      260px circle at var(--mx, -999px) var(--my, -999px),
      #000,
      transparent
    );
  }

  .hero[data-lit] .lit {
    opacity: 1;
  }
</style>

<script>
  // The local time in Kraków. Shown only once the script runs.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const wrap = document.querySelector<HTMLElement>('[data-clock-wrap]');
  if (clock && wrap) {
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Warsaw',
    });
    // Tick on the minute, so the clock never lags behind.
    const tick = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      setTimeout(tick, 60_000 - (now.getTime() % 60_000));
    };
    tick();
    wrap.hidden = false;
  }
</script>

<script>
  // The lit lines need a real mouse and no preference for reduced motion.
  const hero = document.querySelector<HTMLElement>('.hero');
  const fine = matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );
  if (hero && fine.matches) {
    let frame = 0;
    hero.addEventListener('pointermove', (event) => {
      // Touch and pen movement never lights the lines, even where the device reports a fine pointer.
      if (event.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${event.clientX - box.left}px`);
        hero.style.setProperty('--my', `${event.clientY - box.top}px`);
        hero.dataset.lit = '';
      });
    });
    hero.addEventListener('pointerleave', () => {
      delete hero.dataset.lit;
    });
  }
</script>
