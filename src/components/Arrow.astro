---
interface Props {
  direction: 'right' | 'left' | 'up-right';
  class?: string;
}

const { direction, class: className } = Astro.props;

// One thin stroke with a sharp tip, so every arrow shares the weight of the site's lines.
const paths = {
  right: 'M1.5 8h12.5M9 3l5 5-5 5',
  left: 'M14.5 8H2M7 3L2 8l5 5',
  'up-right': 'M3.5 12.5l9-9M5 3.5h7.5V11',
} as const;
---

<svg
  viewBox="0 0 16 16"
  aria-hidden="true"
  class:list={[
    'inline-block h-[.9em] w-[.9em] flex-none align-baseline',
    className,
  ]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="butt"
  stroke-linejoin="miter"
>
  <path d={paths[direction]}></path>
</svg>
