---
// The logo has one version only: an F built from pills and dots, in a disc with a ring.
const { size = 30 } = Astro.props as { size?: number };
---

<svg
  data-bp="Logo.astro"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  class="block flex-none"
>
  <circle cx="24" cy="24" r="24" fill="#1b1b1b"></circle>
  <circle
    cx="24"
    cy="24"
    r="19.2"
    fill="none"
    stroke="#fff"
    stroke-width="2.6"
  ></circle>
  <g transform="translate(6 6) scale(.75)" fill="#fff">
    <rect x="9" y="9" width="30" height="8" rx="4"></rect>
    <rect x="9" y="20" width="19" height="8" rx="4"></rect>
    <circle cx="35" cy="24" r="4" opacity=".42"></circle>
    <circle cx="13" cy="35" r="4"></circle>
    <circle cx="24" cy="35" r="4" opacity=".42"></circle>
    <circle cx="35" cy="35" r="4" opacity=".42"></circle>
  </g>
</svg>
